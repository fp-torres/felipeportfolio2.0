# Copied to dist/ by Vite and published to Hostinger (LiteSpeed + hcdn CDN, Apache-compatible .htaccess).
# Module-specific rules sit inside <IfModule>, so a module the server lacks is skipped instead of causing a 500.

<Files "config.php">
  Require all denied
</Files>

Options -Indexes

# Never serve dotfiles (/.ftp-deploy-sync-state.json…), internal PHP helpers (_bridge.php) or config*.php
# (config.example.php). Matched on file names only: Vite chunks whose names start with "_" stay public.
<FilesMatch "^\.|^_.*\.php$|^config.*\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Report-only: logs what an enforced policy would block (browser console), blocks nothing.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; font-src 'self' data:; connect-src 'self' https://api.lanyard.rest https://dev.to https://api.nasa.gov https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://apod.nasa.gov; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header unset X-Powered-By

  # HTML revalidates on every visit, so a deploy is picked up at once (and never points at deleted chunks).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Vite's content-hashed files (name-XXXXXXXX.ext, only emitted in /assets/) never change.
  # PHP bridges set their own Cache-Control.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|pdf|mp3|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Same rule by MIME type, for "/" (index.html served as the directory index), in case the server matches
# <FilesMatch> only against the requested name. LiteSpeed already applies Expires to images and scripts.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compression fallback (the CDN already serves Brotli).
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
  </IfModule>
</IfModule>
